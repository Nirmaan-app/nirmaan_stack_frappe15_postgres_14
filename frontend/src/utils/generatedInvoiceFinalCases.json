    { "name": "more than ten rupees short is RA", "wo_amount": 100000, "billed": 50000, "amount": 49989.99, "final": false },
    { "name": "previous invoices count", "wo_amount": 250000, "billed": 200000, "amount": 50000, "final": true },
    { "name": "previous invoices not enough", "wo_amount": 250000, "billed": 0, "amount": 50000, "final": false },
