   "fieldtype": "Link",
   "label": "Project",
   "options": "Projects"
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "in_list_view": 1,
   "label": "Amount",
   "reqd": 1
  },
  {
   "description": "Mirrors the ledgers' own `comment` field. The REQUESTER's note -- the reviewer's is `review_comment`.",
