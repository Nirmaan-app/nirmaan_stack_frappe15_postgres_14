  {
   "description": "Mirror of Expense Type.project, fetched so `depends_on` can read it -- Frappe cannot evaluate a linked doctype's field. Not user data; never edit it directly.",
   "fetch_from": "type.project",
   "fieldname": "type_allows_project",
   "fieldtype": "Check",
   "hidden": 1,
   "label": "Type Allows Project",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.type_allows_project",
   "description": "Shown only for an Expense Type flagged `project`. Its PRESENCE decides which ledger Approve writes to -- set means Project Expenses, blank means Non Project Expenses. There is deliberately no separate `expense_kind` field.",
