   "fieldtype": "Small Text",
   "label": "Comment"
  },
  {
   "fieldname": "form_response_section",
   "fieldtype": "Section Break",
   "label": "Form Response"
  },
  {
   "description": "Answers to the Expense Type's source_format, as JSON. NULL is normal and valid -- a type that declares no format is still fully requestable on the native fields alone.",
