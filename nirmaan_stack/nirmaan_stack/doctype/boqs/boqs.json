   "fieldname": "template_section",
   "fieldtype": "Section Break",
   "label": "Template"
  },
  {
   "default": "0",
   "description": "1 = this is a project-less SCRATCH AUTHORING SOURCE for the master template (ADR-0013 A1-D4). Narrow single purpose: (1) permits the project-less insert in boqs.py before_insert, (2) hides the BoQ from project-facing lists, (3) gates the 'Set as master template' action. NOT 'this row is a template' -- the master template lives in the dedicated BoQ Template doctype. Replaced the retired is_template/template_status.",
   "fieldname": "is_template_source",
   "fieldtype": "Check",
   "label": "Is Template Source"
  },
  {
   "default": "upload",
   "description": "How this BoQ was created: 'upload' (Excel ingest, re-parseable), 'template' (cloned from the master template; no source workbook, Configure/Parse suppressed), or 'revision' (ADR-0014 D2 -- a tagged fresh upload of a revised workbook against an already-committed original; re-parseable like an upload, carries provenance via source_boq). Origin-uniform per BoQ (ADR-0013 D4). A 'revision' is an upload for every existing origin gate (S1 audit): it takes the non-template branch everywhere.",
   "fieldname": "origin",
   "fieldtype": "Select",
   "label": "Origin",
   "options": "upload\ntemplate\nrevision",
   "read_only": 1
  },
  {
   "description": "For origin=template BoQs: the master BoQ Template this was cloned from (provenance / analytics). Null for upload BoQs. Repointed from BOQs -> BoQ Template in ADR-0013 A1.",
   "fieldname": "source_template",
   "fieldtype": "Link",
   "label": "Source Template",
   "options": "BoQ Template",
   "read_only": 1
  },
  {
   "description": "For origin=revision BoQs (ADR-0014 D2): the committed ORIGINAL BoQ this revision was uploaded against -- the diff baseline and the source of every carry. Null for upload/template BoQs. Modeled on source_template. Chains are allowed (a committed revision is itself revisable); source_boq forms a strict DAG (the source must pre-exist and be committed), so no cycles. Set by upload_file when source_boq is passed (S2); read-only.",
   "fieldname": "source_boq",
   "fieldtype": "Link",
   "label": "Source BoQ",
   "options": "BOQs",
   "read_only": 1
  }
 ],
