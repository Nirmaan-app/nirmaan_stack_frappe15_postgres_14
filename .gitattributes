# Enforce LF line endings on all text files in the repository
# Prevents CRLF pollution from Windows-checkout sessions
* text=auto eol=lf

# Explicit overrides for files that should stay binary
*.xlsx binary
*.png binary
*.pdf binary
*.jpg binary

# Both sides of a merge append patch lines here; union keeps both instead of conflicting.
# Patches run top to bottom, so check the order after a merge.
nirmaan_stack/patches.txt merge=union
